# Backend API base URL.
# If unset or empty, the frontend sends requests to relative `/api/*`,
# which Vite proxies to https://naavss.duckdns.org in local development (configured in vite.config.js),
# and Vercel proxies in production (configured in vercel.json).
# VITE_API_BASE_URL=https://naavss.duckdns.org

# Set to 'true' to force mock mode in components that support it
# VITE_USE_MOCK_API=false
