# Drill-alert email (EmailJS). Copy to .env and fill in; leave unset to fall back to a mailto: draft.
# Restart the dev server after editing .env - Vite only reads it at startup.
# The template should render {{message}} (full plain-text body) and send to {{to_email}};
# individual fields (spill_id, station_name, coastal_eta, ...) are also provided - see
# src/features/maritime-map/alerts/alertDetails.ts (buildEmailParams).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Demo inbox - every alert goes here, never to the coast guard station.
VITE_EMAILJS_TO_EMAIL=
